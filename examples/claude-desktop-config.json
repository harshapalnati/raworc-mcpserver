{
  "mcpServers": {
    "raworc": {
      "command": "npx",
      "args": ["@raworc/mcp-server"],
      "env": {
        "RAWORC_API_URL": "https://ra-hyp-1.raworc.com/api/v0",
        "RAWORC_AUTH_TOKEN": "<your-token>",
        "RAWORC_DEFAULT_SPACE": "<your-space>",
        "RAWORC_TIMEOUT": "30",
        "LOG_LEVEL": "info",
        "LOG_FORMAT": "json"
      }
    }
  }
}
